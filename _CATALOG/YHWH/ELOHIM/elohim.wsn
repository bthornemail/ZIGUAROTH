YHWHELOHIM = NAME LITERAL IS FROM FIRST OCCURS WITNESSES RELATED FINALS .
NAME = "YHWH Elohim" .
LITERAL = "יהוה אלהים" .
IS = "a double divine name: the Name and Elohim, written side by side with no joining word" .
FROM = "the Westminster Leningrad Codex (public domain), via Sefaria" .
FIRST = "Genesis 2:4, where the second creation account begins" .
OCCURS = "20 times in 19 verses, all in Genesis 2:4 to 3:23 among the chapters taken in: Genesis 2:4, 2:5, 2:7, 2:8, 2:9, 2:15, 2:16, 2:18, 2:19, 2:21, 2:22, 3:1, 3:8 (twice), 3:9, 3:13, 3:14, 3:21, 3:22, 3:23" .
WITNESSES = "Leningrad only; the surviving Aleppo Codex begins at Deuteronomy 28:17, so it has no Genesis" .
RELATED = "its two words have their own entries: YHWH, the Name, and Elohim, the name of the first creation account" .
FINALS = "the last letter is final mem ם (U+05DD), kept as written; reading it as mem מ (U+05DE) is a fold, not the literal" .
