YHWH = NAME LITERAL IS FROM WITNESSES RELATED .
NAME = "YHWH" .
LITERAL = "יהוה" .
IS = "the Name, the four letters yod he vav he" .
FROM = "the Westminster Leningrad Codex (public domain) and Miqra according to the Masorah, based on the Aleppo Codex (CC BY-SA), via Sefaria" .
WITNESSES = "Deuteronomy 29:1 in Sefaria's Hebrew verse numbering (29:2 in most English Bibles): Leningrad writes יְהוָה, MAM writes יְהֹוָה. The consonants are one literal; MAM's pointing has one mark more, holam (U+05B9). Both codices write the Name 18 times in Deuteronomy 29" .
RELATED = "I-229 checks its renderings: ADONAI and THE LORD replace the four letters; YAHWEH keeps them; YAH is their head; JAH and JEHOVAH keep them only under the fold J to Y, V to W (omi-axioms js/catalog/I-229.ts). It is the first word of YHWH Elohim" .
