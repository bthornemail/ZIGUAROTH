START = ( PROGRAM ) .
PROGRAM = ( BLOCK ENDPROGACTION ) .
VARDECL = ( "new" "id" NEWDECLACTION ) .
FORDECL = ( "formal" "id" FORMALDECLACTION ) .
LABDECL = ( "label" "id" LABELDECLACTION ) .
VAR = ( "id" VARIDACTION { "[" EXPR "]" SUBSCRACTION | "." DOTACTION } ) .
LOGVAL = ( "true" LOGVALTRUEACTION ) | ( "false" LOGVALFALSEACTION ) .
NUMBER = ( "realN" | "integerN" ) .
REFERENCE = ( "@" VAR REFERENCEACTION ) .
LISTN = ( "(" LISTHDONEACTION ( ")" LISTNONEACTION | EXPR LISTTL ) ) .
LISTTL = ( ")" LISTNTWOACTION | "," LISTHDTWOACTION ( EXPR LISTTL | ")" LISTNONEACTION ) ) .
PROCHEAD = ( "’" PROCHDACTION { FORDECL ";" PROCFORDECLACTION } ) .
PROCDEF = ( PROCHEAD EXPR "’" PROCDEFACTION ) .
PRIMARY = ( VAR ( LISTN CALLACTION | VALUEACTION ) | PRIMARYONE ) .
PRIMARYONE = ( LOGVAL LOADLOGVALACTION | NUMBER LOADNUMACTION | "symbol" LOADSYMBACTION | REFERENCE | LISTN | "tail" PRIMARY UOPACTION | PROCDEF | "undef" LOADUNDEFACTION | "[" EXPR "]" PARENSACTION | "in" INPUTACTION | "isb" VAR UOPACTION | "isn" VAR UOPACTION | "isr" VAR UOPACTION | "isl" VAR UOPACTION | "isli" VAR UOPACTION | "isy" VAR UOPACTION | "isp" VAR UOPACTION | "isu" VAR UOPACTION | "abs" PRIMARY UOPACTION | "length" VAR UOPACTION | "integer" PRIMARY UOPACTION | "real" PRIMARY UOPACTION | "logical" PRIMARY UOPACTION | "list" PRIMARY UOPACTION ) .
FACTOR = ( PRIMARY FACTORTAIL ) .
FACTORTAIL = ( { "**" PRIMARY BOPACTION } ) .
TERM = ( FACTOR TERMTAIL ) .
TERMTAIL = ( { "*" FACTOR BOPACTION | "/" FACTOR BOPACTION | "div" FACTOR BOPACTION | "mod" FACTOR BOPACTION } ) .
SUM = ( ( "+" TERM UPLUSACTION | "-" TERM NEGACTION | TERM ) SUMTAIL ) .
SUMTAIL = ( { "+" TERM BOPACTION | "-" TERM BOPACTION } ) .
CHOICE = ( SUM CHOICETAIL ) .
CHOICETAIL = ( { "min" SUM BOPACTION | "max" SUM BOPACTION } ) .
RELATION = ( CHOICE RELATIONTAIL ) .
RELATIONTAIL = ( [ "=" CHOICE BOPACTION | "~=" CHOICE BOPACTION | "<" CHOICE BOPACTION | "<=" CHOICE BOPACTION | ">" CHOICE BOPACTION | ">=" CHOICE BOPACTION ] ) .
NEGATION = ( "~" RELATION UOPACTION | RELATION ) .
CONJ = ( NEGATION CONJTAIL ) .
CONJTAIL = ( [ "and" CONJHDACTION CONJ CONJACTION ] ) .
DISJ = ( CONJ DISJTAIL ) .
DISJTAIL = ( [ "or" DISJHDACTION DISJ DISJACTION ] ) .
CATENATAIL = ( { "&" PRIMARY BOPACTION } ) .
TRUEPART = ( EXPR "else" TRUEPTACTION ) .
IFCLAUSE = ( "if" EXPR "then" IFCLSEACTION ) .
EXPR = ( VAR EXPRTAIL | EXPRONE ) .
EXPRTAIL = ( "<-" EXPR BOPACTION | ( LISTN CALLACTION | VALUEACTION ) FACTORTAIL TERMTAIL SUMTAIL CHOICETAIL RELATIONTAIL CONJTAIL DISJTAIL CATENATAIL ) .
EXPRONE = ( BLOCK ) | ( IFCLAUSE TRUEPART EXPR IFEXPRACTION ) | ( "goto" PRIMARY UOPACTION ) | ( "out" EXPR UOPACTION ) | ( PRIMARYONE FACTORTAIL TERMTAIL SUMTAIL CHOICETAIL RELATIONTAIL CONJTAIL DISJTAIL CATENATAIL ) | ( ( "+" TERM UPLUSACTION | "-" TERM NEGACTION ) SUMTAIL CHOICETAIL RELATIONTAIL CONJTAIL DISJTAIL CATENATAIL ) | ( "~" RELATION UOPACTION CONJTAIL DISJTAIL CATENATAIL ) .
STAT = ( EXPRONE | "id" ( ":" LABDEFACTION STAT LABSTMTACTION | VARIDACTION { "[" EXPR "]" SUBSCRACTION | "." DOTACTION } EXPRTAIL ) ) .
BLOCK = ( "begin" BEGINACTION { VARDECL ";" BLKHDACTION | LABDECL ";" BLKHDACTION } STAT { ";" BLKBODYACTION STAT } "end" BLKACTION ) .
