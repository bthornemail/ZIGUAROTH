VIEWS = VIEWSTITLE VIEWSSTATUS VIEWSAUTHOR VIEWSPRINCIPLE VIEWSTIER VIEWSLITERAL VIEWSCHECK VIEWSVIEWS VIEWSFOLDERS .
VIEWSTITLE = "ZIGUAROTH: the views that resolve a _CODE folder, kept beside each other" .
VIEWSSTATUS = "draft, 2026-10-27" .
VIEWSAUTHOR = "Brian James Thorne" .
VIEWSPRINCIPLE = "the author, 2026-10-27: ""The reading for the folder mapping is dependent on view, dependent on resolve""; then ""this is the exact structure we were reaching for, a dissolution of time and meaning to literal code point tree sequences""" .
VIEWSTIER = "-6, CONFIGURATIONS: _ARCHIVE/Configurations, *.yaml, *.wsn" .
VIEWSLITERAL = "a folder's name is its code point (or, for a two-digit pair, its block); it is the literal, and no view renames it (V1)" .
VIEWSCHECK = "node _ARCHIVE/Expressions/views.js" .
VIEWSVIEWS = VIEWSVIEWSTIMELINE VIEWSVIEWSEULER .
VIEWSVIEWSTIMELINE = VIEWSVIEWSTIMELINEBASIS VIEWSVIEWSTIMELINESOURCE .
VIEWSVIEWSTIMELINEBASIS = "the author, 2026-10-25 (rules Y1, Y2)" .
VIEWSVIEWSTIMELINESOURCE = "Longstaff, Calendars from around the world (the astronomical index); the atomic kernel clock (logical time)" .
VIEWSVIEWSEULER = VIEWSVIEWSEULERBASIS VIEWSVIEWSEULERSOURCE VIEWSVIEWSEULERNOTE .
VIEWSVIEWSEULERBASIS = "proposed by another assistant, pasted by the author 2026-10-27; kept by the author as a view the same day" .
VIEWSVIEWSEULERSOURCE = "Wikipedia, Simple precedence grammar (the Wirth-Weber relations, from Wirth and Weber, EULER: A Generalization of ALGOL, and its Formal Definition, 1966); Christopher, EULER: An Experiment in Language Definition, 1996, cited only" .
VIEWSVIEWSEULERNOTE = "Wirth-Weber has three relations; $ is not a relation but the limit marker at both ends of the parse, so this view puts three relations and one marker on four folders. The relation signs are U+22D6 LESS-THAN WITH DOT, U+2250 APPROACHES THE LIMIT, U+22D7 GREATER-THAN WITH DOT" .
VIEWSFOLDERS = VIEWSFOLDERSONEZEROONEZEROZERO VIEWSFOLDERSONEZEROONEZEROONE VIEWSFOLDERSONEZEROONEZEROTWO VIEWSFOLDERSTWOEIGHT .
VIEWSFOLDERSONEZEROONEZEROZERO = VIEWSFOLDERSONEZEROONEZEROZEROLITERAL VIEWSFOLDERSONEZEROONEZEROZEROTIMELINE VIEWSFOLDERSONEZEROONEZEROZEROEULER .
VIEWSFOLDERSONEZEROONEZEROZEROLITERAL = "U+10100 AEGEAN WORD SEPARATOR LINE" .
VIEWSFOLDERSONEZEROONEZEROZEROTIMELINE = "-1, 2 BC" .
VIEWSFOLDERSONEZEROONEZEROZEROEULER = "$, the limit marker: the stack starts with it, the input ends with it" .
VIEWSFOLDERSONEZEROONEZEROONE = VIEWSFOLDERSONEZEROONEZEROONELITERAL VIEWSFOLDERSONEZEROONEZEROONETIMELINE VIEWSFOLDERSONEZEROONEZEROONEEULER .
VIEWSFOLDERSONEZEROONEZEROONELITERAL = "U+10101 AEGEAN WORD SEPARATOR DOT" .
VIEWSFOLDERSONEZEROONEZEROONETIMELINE = "0, 1 BC" .
VIEWSFOLDERSONEZEROONEZEROONEEULER = "⋖, a potential pivot is starting: shift" .
VIEWSFOLDERSONEZEROONEZEROTWO = VIEWSFOLDERSONEZEROONEZEROTWOLITERAL VIEWSFOLDERSONEZEROONEZEROTWOTIMELINE VIEWSFOLDERSONEZEROONEZEROTWOEULER .
VIEWSFOLDERSONEZEROONEZEROTWOLITERAL = "U+10102 AEGEAN CHECK MARK" .
VIEWSFOLDERSONEZEROONEZEROTWOTIMELINE = "+1, AD 1" .
VIEWSFOLDERSONEZEROONEZEROTWOEULER = "≐, a relationship remains in the same pivot: shift" .
VIEWSFOLDERSTWOEIGHT = VIEWSFOLDERSTWOEIGHTLITERAL VIEWSFOLDERSTWOEIGHTTIMELINE VIEWSFOLDERSTWOEIGHTEULER .
VIEWSFOLDERSTWOEIGHTLITERAL = "the pair 28: the braille block, U+2800 BRAILLE PATTERN BLANK to U+28FF BRAILLE PATTERN DOTS-12345678" .
VIEWSFOLDERSTWOEIGHTTIMELINE = "logical time, the units of the atomic kernel clock (the Delta Law), not calendar years" .
VIEWSFOLDERSTWOEIGHTEULER = "⋗, the pivot is found: reduce" .
