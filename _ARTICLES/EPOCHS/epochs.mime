ZIGUA-ROTH: boxed/_archive/_inbox/Calendars from around the world.md
MIME-Version: 1.0
Content-Type: application/yaml; charset=utf-8
Content-Transfer-Encoding: binary
Content-Length: 2618
Content-Description: Where each calendar starts, ordered on the astronomical year index; facts from Longstaff, Calendars from around the world, National Maritime Museum 2005, cited by line

"EPOCHS":
  title: "Where each calendar starts, on one axis"
  source: "Alan Longstaff, Calendars from around the world, National Maritime Museum, 2005 (copy: boxed/_archive/_inbox/Calendars from around the world.md)"
  axis: "the astronomical year index (rule Y3): AD/CE n is n, n BC/BCE is 1 - n; read with _CODE/U/10100, 10101, 10102 as -1, 0, +1"
  note: "the index orders the starting years only; calendars whose years begin on different days, or are not solar, cannot be converted by an offset alone"
  order:
    - calendar: "Hebrew (Anno Mundi)"
      written: "3761 BCE"
      index: "-3760"
      begins: "the creation of the world, 6 October 3761 BCE (Julian), after sunset"
      maps: "its year begins in autumn, so an AM year spans two Gregorian years; no constant offset holds for the whole year"
      cite: "Longstaff 2005, line 539"
    - calendar: "Chinese, Yellow Emperor count"
      written: "2698 BCE"
      index: "-2697"
      begins: "the Yellow Emperor's reign"
      maps: "the source's rule is Chinese year = 2698 + CE year, so 2005 is 4703"
      cite: "Longstaff 2005, line 793"
    - calendar: "Chinese, invention count"
      written: "2637 BCE"
      index: "-2636"
      begins: "the year the calendar was supposed to have been invented"
      maps: "a second epoch for the same calendar"
      cite: "Longstaff 2005, line 791"
    - calendar: "Julian"
      written: "46 BCE"
      index: "-45"
      begins: "the reform by Julius Caesar; 46 BCE was given 445 days"
      maps: "the first ordinary Julian year was the next, 45 BCE"
      cite: "Longstaff 2005, line 426"
    - calendar: "Anno Domini"
      written: "1 CE"
      index: "1"
      begins: "Dionysius Exiguus' year of the Incarnation"
      maps: "the index itself; BC/AD has no year zero (line 490)"
      cite: "Longstaff 2005, line 487"
    - calendar: "Indian National (Saka)"
      written: "79 CE"
      index: "79"
      begins: "1 Saka begins at the vernal equinox of 79 CE"
      maps: "the source's rule is to add 78 to the Saka year (line 663): 78 is the gap, 79 the first year"
      cite: "Longstaff 2005, line 658"
    - calendar: "Islamic (Hijri)"
      written: "622 CE"
      index: "622"
      begins: "Islamic Year 1"
      maps: "a lunar year of about 354 days, so no constant offset exists; Islamic New Year 1425 began on 22 February 2004"
      cite: "Longstaff 2005, line 628"
    - calendar: "Gregorian reform"
      written: "1582 CE"
      index: "1582"
      begins: "the reform of the Julian calendar"
      maps: "adopted slowly, country by country"
      cite: "Longstaff 2005, line 477"
